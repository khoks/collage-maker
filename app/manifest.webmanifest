{
  "name": "Collage Maker",
  "short_name": "Collage Maker",
  "description": "Drop photos, get a clean 8K collage with white borders. Works offline; your photos never leave your device.",
  "id": "/collage-maker/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#d5d8df",
